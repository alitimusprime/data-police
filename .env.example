# Copying this file is not enough: run python scripts/bootstrap.py for secure local secrets.
DP_ENV=development
DP_DATA_DIR=./runtime
DP_DATABASE_URL=sqlite:///./runtime/platform.db
DP_SOURCE_DATABASE_URL=sqlite:///./runtime/source.db
DP_DEMO_API_URL=http://127.0.0.1:8001
DP_REDIS_URL=redis://localhost:6379/0
DP_EXECUTOR=local
DP_ADMIN_EMAIL=admin@datapolice.local
DP_ADMIN_PASSWORD=
DP_SESSION_SECRET=
DP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
DP_COOKIE_SECURE=false
DP_ENABLE_SIMULATOR=true
DP_FRESHNESS_SECONDS=180
DP_AUTO_RUN_SECONDS=60
# Optional. No evidence is sent externally until an administrator explicitly requests it.
DP_LLM_BASE_URL=
DP_LLM_API_KEY=
DP_LLM_MODEL=
# Docker Compose uses these two secrets, generated by bootstrap.py.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
